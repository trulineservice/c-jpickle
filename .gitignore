# ==============================================================================
# Next.js & Supabase Project - .gitignore
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output
/.next/
/out/
/build
/dist

# Turbo & Vercel
.turbo/
.vercel/

# Environment Variables & Secrets (Prevent accidental leaks)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem

# Allow committing example environment template
!.env.example

# Scratch & Temporary Test Files
scratch/

# Supabase Local Cache & Secrets
.supabase/local
supabase/.temp

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.log

# Testing & Coverage
/coverage
/.nyc_output

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel
.env*
.mcp.json

# Temporary subagent teamwork and scratch sessions
.agents/orchestrator_*
.agents/sentinel/
.agents/teamwork_*
.agents/victory_*
.agents/ORIGINAL_REQUEST.md
