# ==========================================
# C&J Pickleball Arena - Environment Variables Template
# ==========================================

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-jwt-key
# Grab from Supabase Dashboard > Project Settings > API > service_role key (secret)
# Required for admin user creation, password reset, and webhook bypass:
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# Email Service Configuration
# Emails are sent directly via Resend or Nodemailer SMTP (NOT from Supabase)
# ==========================================
# Option 1: Resend API (Recommended)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="C&J Court <bookings@cjcourt.com>"

# Option 2: Nodemailer / Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_PASS=your_16_character_app_password

# ==========================================
# PayMongo Credentials (Philippines Gateway)
# ==========================================
PAYMONGO_SECRET_KEY=sk_live_or_test_key
PAYMONGO_PUBLIC_KEY=pk_live_or_test_key
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_secret

# Application Public URL
NEXT_PUBLIC_APP_URL=https://c-j-pickleball.vercel.app
